# ── Secrets — NEVER commit ─────────────────────────────
config.json
*.env
.env*

# ── Claude Code tool settings (dev-machine-specific) ───
.claude/

# ── Raw SQL dumps in repo root (non-URL-replaced) ──────
# Use niches/{niche}/{niche}-store.sql (URL-replaced) instead
/pet-store.sql
/auto-store.sql

# ── Runtime / venv ──────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── Logs, DB exports, reports ──────────────────────────
logs/
db/
reports/

# ── WordPress: do NOT commit these from niches/ ─────────
# (too large, runtime-generated, or sensitive)
niches/*/wp-content/cache/
niches/*/wp-content/upgrade/
niches/*/wp-content/ai-content/
niches/*/wp-content/uploads/
niches/*/wp-content/ai1wm-backups/
niches/*/wp-content/*.log
niches/*/wp-content/wp-cache-config.php
niches/*/wp-content/advanced-cache.php
niches/*/wp-content/advanced-headers.php

# Commit themes, plugins, mu-plugins, languages, SQL — everything else in niches/

# ── SSH keys ────────────────────────────────────────────
*.pem
*_rsa
*_rsa.pub
